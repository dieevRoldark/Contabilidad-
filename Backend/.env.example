PORT=3000
# 🔐 CAMBIAME — Genera tu propio secreto con:
#    openssl rand -base64 32   (256 bits, recomendado para HS256)
#    openssl rand -base64 64   (512 bits, si usas HS512)
# NUNCA uses el valor de ejemplo en produccion.
JWT_SECRET=CHANGEME_generate_with_openssl_rand_base64_32
JWT_REFRESH_SECRET=CHANGEME_same_256_bits_minimum

SSL_ENABLED=false
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem
DOMAIN=localhost
CORS_ORIGIN=http://localhost:5173

# XAMPP: usuario root, password vacio
# Docker: usuario app_user, password app_doris
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=MarketD&D_db
